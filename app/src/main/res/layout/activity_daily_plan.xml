<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvDailyPlanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_plan_header"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_select_project"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:textColor="#666666"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <Spinner
                    android:id="@+id/spinnerProjects"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_border" />

                <ImageButton
                    android:id="@+id/btnEditCurrentProject"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:background="@drawable/edit_text_border"
                    app:tint="@color/primary"
                    android:contentDescription="@string/btn_edit" />

                <ImageButton
                    android:id="@+id/btnDeleteCurrentProject"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:background="@drawable/edit_text_border"
                    android:backgroundTint="#FFE5E5"
                    app:tint="@color/error"
                    android:contentDescription="@string/desc_delete_project" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/white">

                    <TextView
                        android:id="@+id/tvWorkloadTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_your_status"
                        android:textSize="14sp"
                        android:textColor="#999999"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvWorkloadMain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/workload_placeholder"
                        android:textSize="20sp"
                        android:textColor="#333333"
                        android:lineSpacingExtra="4dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginVertical="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_daily_recommendation"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvDailyRecommendation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/placeholder_daily_recommendation"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_add_progress"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:textColor="#666666"/>

            <EditText
                android:id="@+id/etProgress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/progress_hint"
                android:inputType="number"
                android:background="@drawable/edit_text_border"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnSaveProgress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_save"
                android:textSize="16sp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"/>

        </LinearLayout>
    </ScrollView>

    <!-- Navigation Bar -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="16dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/btnNavDaily"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_today"
                app:tint="@color/primary"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_today"
                android:textSize="12sp"
                android:textColor="@color/primary"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavGoal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_input_add"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_new"
                android:textSize="12sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavEval"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_stats"
                android:textSize="12sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/nav_inactive"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:textSize="12sp"
                android:textColor="@color/nav_inactive"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>